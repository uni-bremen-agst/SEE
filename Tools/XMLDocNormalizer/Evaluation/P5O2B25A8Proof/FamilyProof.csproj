<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FamilyProof.cs" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(AnalyzerOutput)/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(AnalyzerOutput)/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <Reference Include="System.Collections.Immutable"><HintPath>$(AnalyzerOutput)/System.Collections.Immutable.dll</HintPath></Reference>
    <Reference Include="System.Reflection.Metadata"><HintPath>$(AnalyzerOutput)/System.Reflection.Metadata.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireActualCurrent" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AnalyzerOutput)/Microsoft.CodeAnalysis.CSharp.dll')" Text="Use the freshly built Current output, never download or substitute a compiler." />
  </Target>
</Project>
