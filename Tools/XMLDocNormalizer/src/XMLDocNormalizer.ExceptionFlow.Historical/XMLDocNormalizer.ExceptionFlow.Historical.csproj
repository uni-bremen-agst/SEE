<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>XMLDocNormalizer.ExceptionFlow.Historical</AssemblyName>
    <RootNamespace>XMLDocNormalizer</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="[5.0.0-2.25451.107]" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.0.0-2.25451.107]" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="[3.11.0]" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable" Version="[9.0.0]" />
    <PackageReference Include="System.Reflection.Metadata" Version="[9.0.0]" />
    <Compile Include="BuildOnlySemanticEnvironment.cs" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>ExecutionContract</_Parameter1>
      <_Parameter2>BuildOnly; requires an isolated runtime host</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Import Project="../../build/ExceptionFlow.HistoricalSources.props" />
</Project>
